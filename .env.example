# Copy to `.env.local` for local development. Never commit real keys.
# On Vercel: Project → Settings → Environment Variables (same names).

# mock | gemini
COACH_PROVIDER=gemini

# Gemini video coaching. Server-only. Do not prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Vercel Blob client uploads. Server-only. Do not prefix with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
