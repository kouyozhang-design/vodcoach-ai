# Copy to `.env.local` for local development. Never commit real keys.
# On Vercel: Project → Settings → Environment Variables (same names).

# mock | openai | gemini
COACH_PROVIDER=mock

# OpenAI video / GPT-4o coaching. Server-only. Do not prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Google Gemini video coaching. Server-only. Do not prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
