# Copy to `.env.local` for local development. Never commit real keys.
# On Vercel: Project → Settings → Environment Variables (same names).

# mock | gemini
COACH_PROVIDER=gemini

# Gemini video coaching. Server-only. Do not prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Vercel Blob client uploads. Server-only. Do not prefix with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Supabase Auth (email link). URL and anon key are public; RLS blocks profile writes.
# Service role stays on the server. It is the only key that may write profiles.status.
# In Supabase, allow this site's /auth/callback as a redirect URL, then run
# supabase/migrations/20261026120000_profiles.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing. Server-only. Never prefix with NEXT_PUBLIC_.
# STRIPE_PRICE_ID is a Stripe Price (price_...). The browser must not choose it.
# STRIPE_WEBHOOK_SECRET verifies the Stripe-Signature header on the raw webhook body.
# Point the Stripe webhook at /api/stripe/webhook for checkout.session.completed,
# checkout.session.async_payment_succeeded, and customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
